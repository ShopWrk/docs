{
  "$schema": "https://mintlify.com/docs.json",
  "name": "ShopWrk",
  "theme": "maple",
  "description": "Help for running your ShopWrk shop.",
  "favicon": {
    "light": "/images/ShopWrk-WhiteBGLogo.png",
    "dark": "/images/ShopWrkIconLogoBlackBG.png"
  },
  "colors": {
    "primary": "#734A2D",
    "light": "#C9A06A",
    "dark": "#734A2D"
  },
  "logo": {
    "light": "/images/ShopWrkFullLogo-Black.png",
    "dark": "/images/ShopwrkWhiteLogo-NOBG.png",
    "href": "https://shopwrk.com"
  },
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "family": "Inter",
    "heading": {
      "family": "Inter",
      "weight": 600
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "decoration": "gradient"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Sign in",
      "href": "https://app.shopwrk.com"
    }
  },
  "footer": {
    "socials": {
      "website": "https://shopwrk.com"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Help",
        "icon": "book-open",
        "groups": [
          {
            "group": "Start here",
            "icon": "rocket",
            "pages": [
              "introduction",
              "getting-started/account-setup",
              "getting-started/onboarding",
              "getting-started/first-job",
              "getting-started/roles-permissions"
            ]
          },
          {
            "group": "Jobs",
            "icon": "wrench",
            "pages": [
              "workflows/estimates",
              "workflows/jobs",
              "workflows/invoices-payments",
              "features/calendar-booking",
              "workflows/customer-portal"
            ]
          },
          {
            "group": "Customers",
            "icon": "users",
            "pages": [
              "features/crm",
              "features/communications",
              "features/campaigns",
              "features/forms",
              "features/documents",
              "features/warranties"
            ]
          },
          {
            "group": "Team",
            "icon": "users-round",
            "pages": [
              "features/team-scheduling",
              "features/inventory"
            ]
          },
          {
            "group": "AI",
            "icon": "sparkles",
            "pages": [
              "features/ai-agents",
              "features/ai-assistant",
              "features/lead-closer",
              "features/automations",
              "features/command-palette",
              "features/reports"
            ]
          },
          {
            "group": "Payments",
            "icon": "credit-card",
            "pages": [
              "integrations/shopwrk-pay",
              "settings/billing"
            ]
          },
          {
            "group": "Connections",
            "icon": "unplug",
            "pages": [
              "integrations/sms-voice",
              "integrations/google-calendar",
              "integrations/social-media",
              "integrations/site-tracker",
              "settings/email-domain"
            ]
          },
          {
            "group": "Settings",
            "icon": "settings",
            "pages": [
              "settings/services-catalog",
              "settings/checklists",
              "settings/branding",
              "settings/shopwrker",
              "settings/data-management"
            ]
          }
        ]
      },
      {
        "tab": "Mobile",
        "icon": "smartphone",
        "groups": [
          {
            "group": "iOS app",
            "pages": [
              "mobile/overview",
              "mobile/getting-started",
              "mobile/owner-features",
              "mobile/technician-features"
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/integrations/stripe-payments",
      "destination": "/integrations/shopwrk-pay",
      "permanent": true
    },
    {
      "source": "/settings/webhooks",
      "destination": "/settings/billing",
      "permanent": true
    },
    {
      "source": "/integrations/meta",
      "destination": "/integrations/social-media",
      "permanent": true
    },
    {
      "source": "/settings/sending-domain",
      "destination": "/settings/email-domain",
      "permanent": true
    }
  ],
  "styling": {
    "eyebrows": "breadcrumbs"
  }
}
