  "keyFeatures": [
    "CRM & customer profiles with vehicle history",
    "Tier-based estimate builder (Good/Better/Best) with customer approval workflow",
    "Job scheduling with calendar view, bay management, and technician assignment",
    "Stripe-integrated invoicing with payment schedules and online payments",
    "Online booking page with customer-facing availability checking",
    "SMS, voice, and email communications with A2P 10DLC compliance",
    "Visual automation workflow builder with 14+ pre-built templates",
    "AI assistant with 79 tools for customers, jobs, estimates, invoices, and analytics",
    "Inventory tracking with low-stock alerts and film catalog management",
    "Warranty registration and claim processing",
    "Social media posting to Meta, TikTok, and Google Business",
    "Team scheduling, timesheets, and payroll management",
    "Customer portal with magic-link access for estimates, invoices, and warranties",
    "iOS mobile app for owners and technicians"
  ],
  "publicApiSurface": [
    "GET /api/public/booking — public booking availability",
    "POST /api/public/booking — submit booking request",
    "GET /view/estimate/[token] — token-authenticated estimate view",
    "GET /view/invoice/[token] — token-authenticated invoice view",
    "POST /api/portal/* — customer portal actions",
    "GET /api/portal/jobs — customer portal job list",
    "POST /api/webhooks/stripe — Stripe payment webhooks",
    "POST /api/webhooks/telnyx — Telnyx SMS/voice webhooks",
    "POST /api/voice/* — Telnyx voice call handling",
    "GET /api/health — health check endpoint",
    "POST /api/customers — create customer",
    "GET /api/customers — list customers",
    "POST /api/estimates — create estimate",
    "POST /api/invoices — create invoice",
    "POST /api/jobs — create job",
    "POST /api/upload — file uploads"
  ]
